local espObjects = {}

local function makeEspObj(player)
    local obj = {
        box      = Drawing.new("Square"),
        name     = Drawing.new("Text"),
        healthBg = Drawing.new("Square"),
        health   = Drawing.new("Square"),
        tracer   = Drawing.new("Line"),
        distance = Drawing.new("Text"),
    }
    obj.box.Visible       = false; obj.box.Thickness  = 1; obj.box.Filled = false
    obj.box.Color         = CONFIG.colorEnemy
    obj.name.Visible      = false; obj.name.Size      = 13
    obj.name.Font         = Drawing.Fonts.UI; obj.name.Center  = true
    obj.name.Outline      = true;  obj.name.Color     = CONFIG.colorText
    obj.healthBg.Visible  = false; obj.healthBg.Filled = true
    obj.healthBg.Color    = Color3.fromRGB(0, 0, 0)
    obj.health.Visible    = false; obj.health.Filled  = true
    obj.tracer.Visible    = false; obj.tracer.Thickness = 1
    obj.tracer.Color      = CONFIG.colorTracer
    obj.distance.Visible  = false; obj.distance.Size  = 11
    obj.distance.Font     = Drawing.Fonts.UI
    obj.distance.Center   = true;  obj.distance.Outline = true
    obj.distance.Color    = CONFIG.colorText
    espObjects[player]    = obj
end

local function removeEspObj(player)
    local obj = espObjects[player]
    if not obj then return end
    for _, d in pairs(obj) do pcall(function() d:Remove() end) end
    espObjects[player] = nil
end

local function hideEspObj(obj)
    for _, d in pairs(obj) do d.Visible = false end
end

for _, p in ipairs(playersService:GetPlayers()) do
    if p ~= localPlayer then makeEspObj(p) end
end
playersService.PlayerAdded:Connect(function(p) makeEspObj(p) end)
playersService.PlayerRemoving:Connect(function(p)
    removeEspObj(p)
    removeHitbox(p)
end)

