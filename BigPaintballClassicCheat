-- Hooks — wallbang via __index (new workspace:Raycast API)
-- Also strips FilterDescendantsInstances so walls are included in the cast
--------------------------------------------------------------------------------

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    local val = oldIndex(self, key)

    if CONFIG.wallbang and key == "Raycast" and (self == workspaceService or self == workspace) then
        return newcclosure(function(ws, origin, direction, params)
            local ignore = {}
            local totalLength = direction.Magnitude

            for _ = 1, 20 do
                -- Build fresh params that exclude already-hit walls
                -- Force include mode so whitelist filters don't block walls
                local p = RaycastParams.new()
                p.FilterType                 = Enum.RaycastFilterType.Exclude
                p.FilterDescendantsInstances = ignore

                local result = val(ws, origin, direction, p)
                if not result then return nil end
                if isCharacterPart(result.Instance) then return result end

                table.insert(ignore, result.Instance)
                local traveled = (result.Position - origin).Magnitude
                local remaining = totalLength - traveled
                if remaining < 0.1 then return nil end
                origin    = result.Position + direction.Unit * 0.05
                direction = direction.Unit * remaining
            end

            return nil
        end)
    end

    return val
end))

