--------------------------------------------------------------------------------
-- Render loop
--------------------------------------------------------------------------------

runService.RenderStepped:Connect(function()
    fovCircle.Visible  = CONFIG.showFovCircle
    fovCircle.Position = userInputService:GetMouseLocation()
    fovCircle.Radius   = CONFIG.aimbotFov

    for _, player in ipairs(playersService:GetPlayers()) do
        if player == localPlayer then continue end

        -- Hitbox/silent aim share the same part pool
        -- Silent aim: huge invisible part; hitbox expander: visible sized part
        local needPart = CONFIG.hitbox or CONFIG.silentAim
        if needPart and isAlive(player) then
            local part = getOrCreateHitbox(player)
            if part then
                if CONFIG.silentAim then
                    -- Silent aim takes priority — massive nearly-invisible bubble
                    local s = CONFIG.silentAimSize
                    part.Size         = Vector3.new(s, s, s)
                    part.Transparency = 0.98
                    part.Color        = CONFIG.hitboxColor
                elseif CONFIG.hitbox then
                    local s = CONFIG.hitboxSize
                    part.Size         = Vector3.new(s, s, s)
                    part.Transparency = CONFIG.hitboxTransparency
                    part.Color        = CONFIG.hitboxColor
                end
            end
        else
            removeHitbox(player)
        end

        -- ESP
        local obj = espObjects[player]
        if not obj then continue end

        if not CONFIG.esp or not isAlive(player) then
            hideEspObj(obj); continue
        end

        local char = player.Character
        local hrp  = getHRP(player)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then hideEspObj(obj); continue end

        local worldDist = (hrp.Position - currentCamera.CFrame.Position).Magnitude
        if worldDist > CONFIG.espMaxDist then hideEspObj(obj); continue end

        local rootSp, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
        if not onScreen then hideEspObj(obj); continue end

        local head   = char:FindFirstChild("Head")
        local headSp = head and currentCamera:WorldToViewportPoint(head.Position) or rootSp

        local sRoot = Vector2.new(rootSp.X, rootSp.Y)
        local sHead = Vector2.new(headSp.X, headSp.Y)
        local boxH  = math.abs(sRoot.Y - sHead.Y) * 2.2
        local boxW  = boxH * 0.55
        local boxX  = sRoot.X - boxW / 2
        local boxY  = sHead.Y - boxH * 0.08

        if CONFIG.espBoxes then
            obj.box.Visible  = true
            obj.box.Size     = Vector2.new(boxW, boxH)
            obj.box.Position = Vector2.new(boxX, boxY)
        else obj.box.Visible = false end

        if CONFIG.espNames then
            obj.name.Visible  = true
            obj.name.Text     = player.Name
            obj.name.Position = Vector2.new(sRoot.X, boxY - 15)
        else obj.name.Visible = false end

        if CONFIG.espHealth then
            local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            local bw, bx = 4, boxX - 6
            obj.healthBg.Visible  = true
            obj.healthBg.Size     = Vector2.new(bw, boxH)
            obj.healthBg.Position = Vector2.new(bx, boxY)
            obj.health.Visible    = true
            obj.health.Size       = Vector2.new(bw, boxH * ratio)
            obj.health.Position   = Vector2.new(bx, boxY + boxH * (1 - ratio))
            obj.health.Color      = CONFIG.colorHealthLow:Lerp(CONFIG.colorHealthHigh, ratio)
        else
            obj.health.Visible   = false
            obj.healthBg.Visible = false
        end

        if CONFIG.espTracers then
            local vp = currentCamera.ViewportSize
            obj.tracer.Visible = true
            obj.tracer.From    = Vector2.new(vp.X / 2, vp.Y)
            obj.tracer.To      = sRoot
        else obj.tracer.Visible = false end

        if CONFIG.espDistance then
            obj.distance.Visible  = true
            obj.distance.Text     = math.floor(worldDist / 3) .. "m"
            obj.distance.Position = Vector2.new(sRoot.X, boxY + boxH + 2)
        else obj.distance.Visible = false end
    end

    if CONFIG.aimbot and userInputService:IsMouseButtonPressed(CONFIG.aimbotKey) then
        local target = getClosestPlayer(CONFIG.aimbotFov)
        if target then
            local bone = getBone(target, CONFIG.aimbotBone)
            if bone then
                local _, onScreen = currentCamera:WorldToViewportPoint(bone.Position)
                if onScreen then
                    currentCamera.CFrame = currentCamera.CFrame:Lerp(
                        CFrame.new(currentCamera.CFrame.Position, bone.Position),
                        CONFIG.aimbotSmoothing
                    )
                end
            end
        end
    end
end)

--------------------------------------------------------------------------------
-- Hooks — wallbang via __namecall (legacy ray APIs)
-- Wallbang works by stripping the RaycastParams filter so the ray hits
-- everything, then skipping non-character hits and re-casting past them
--------------------------------------------------------------------------------

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()

    if CONFIG.wallbang then
        if method == "FindPartOnRayWithWhitelist" or
           method == "FindPartOnRayWithIgnoreList" or
           method == "FindPartOnRay" then
            local args   = {...}
            local ray    = args[1]
            if typeof(ray) == "Ray" then
                local origin    = ray.Origin
                local direction = ray.Direction
                local ignore    = (method == "FindPartOnRayWithIgnoreList" and type(args[2]) == "table" and args[2]) or {}
                for _ = 1, 20 do
                    args[1] = Ray.new(origin, direction)
                    if method == "FindPartOnRayWithIgnoreList" then
                        args[2] = ignore
                    end
                    local hit, pos, normal, mat = oldNamecall(self, unpack(args))
                    if not hit then return hit, pos, normal, mat end
                    if isCharacterPart(hit) then return hit, pos, normal, mat end
                    table.insert(ignore, hit)
                    local traveled = (pos - ray.Origin).Magnitude
                    local remaining = direction.Magnitude - traveled
                    if remaining < 0.1 then return hit, pos, normal, mat end
                    origin    = pos + direction.Unit * 0.05
                    direction = direction.Unit * remaining
                end
            end
        end
    end

    return oldNamecall(self, ...)
end))

