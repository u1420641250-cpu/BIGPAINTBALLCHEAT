--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getHRP(player)
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getBone(player, bone)
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild(bone) or char:FindFirstChild("HumanoidRootPart")
end

local function getClosestPlayer(fovRadius)
    local closest, closestDist = nil, math.huge
    local mousePos = userInputService:GetMouseLocation()
    for _, player in ipairs(playersService:GetPlayers()) do
        if player == localPlayer or not isAlive(player) then continue end
        local hrp = getHRP(player)
        if not hrp then continue end
        local sp, onScreen = currentCamera:WorldToViewportPoint(hrp.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
        if dist < fovRadius and dist < closestDist then
            closest, closestDist = player, dist
        end
    end
    return closest
end

local function isCharacterPart(part)
    for _, player in ipairs(playersService:GetPlayers()) do
        if player.Character and part:IsDescendantOf(player.Character) then
            return true
        end
    end
    return false
end

--------------------------------------------------------------------------------
-- Hitbox expander
-- Silent aim shares the same pool but overrides size + transparency
--------------------------------------------------------------------------------

local function getOrCreateHitbox(player)
    if hitboxParts[player] then return hitboxParts[player] end
    local hrp = getHRP(player)
    if not hrp then return nil end

    local part = Instance.new("Part")
    part.Name         = "HitboxExpander"
    part.Anchored     = false
    part.CanCollide   = false
    part.Massless     = true
    part.CastShadow   = false
    part.Color        = CONFIG.hitboxColor
    part.Material     = Enum.Material.ForceField
    part.Size         = Vector3.new(1, 1, 1)
    part.Transparency = 0.5

    local weld = Instance.new("WeldConstraint")
    weld.Part0  = part
    weld.Part1  = hrp
    weld.Parent = part

    part.CFrame = hrp.CFrame
    part.Parent = hrp.Parent

    hitboxParts[player] = part
    return part
end

local function removeHitbox(player)
    local part = hitboxParts[player]
    if not part then return end
    pcall(function() part:Destroy() end)
    hitboxParts[player] = nil
end

playersService.PlayerRemoving:Connect(removeHitbox)
playersService.PlayerAdded:Connect(function(player)
    player.CharacterRemoving:Connect(function() removeHitbox(player) end)
end)
for _, player in ipairs(playersService:GetPlayers()) do
    if player ~= localPlayer then
        player.CharacterRemoving:Connect(function() removeHitbox(player) end)
    end
end

